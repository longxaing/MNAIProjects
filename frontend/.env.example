# Frontend environment. Copy to `.env.local` and adjust.

# Optional absolute API base. Leave empty to use the Vite dev proxy (/api -> backend).
VITE_API_BASE=

# Azure AD (Entra ID) SPA app registration. Leave VITE_AAD_CLIENT_ID empty to run in
# local dev mode (no login; the backend DevAuth handler accepts requests).
VITE_AAD_CLIENT_ID=
VITE_AAD_TENANT=organizations
# The API scope exposed by your backend app registration, e.g. api://<api-client-id>/access_as_user
VITE_API_SCOPE=
