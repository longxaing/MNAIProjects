<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MnaiWork.Api</RootNamespace>
    <!-- OPENAI001: the Responses API surface is marked experimental in the SDK. -->
    <NoWarn>$(NoWarn);OPENAI001</NoWarn>
    <!-- We use a System.Text.Json Cosmos serializer, so Newtonsoft.Json is not required. -->
    <AzureCosmosDisableNewtonsoftJsonCheck>true</AzureCosmosDisableNewtonsoftJsonCheck>
    <UserSecretsId>20f2d833-47c3-4fe4-be3d-c9dbc65ec14c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.1" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.61.0" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.12.2" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="OpenAI" Version="2.12.0" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\..\infra\generated-deployment\main.json"
              Link="Deployment\Templates\generated-deployment.json" />
    <EmbeddedResource Include="Agent\Skills\skill_packs\software-factory\SKILL.md">
      <LogicalName>MnaiWork.Api.Agent.Skills.skill_packs.software_factory.SKILL.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\tests\BuildWorkerFixture\GeneratedApp.sln">
      <LogicalName>MnaiWork.Api.Agent.ProjectTemplate/GeneratedApp.sln</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\tests\BuildWorkerFixture\src\backend\**\*.cs;..\..\tests\BuildWorkerFixture\src\backend\**\*.csproj"
              Exclude="..\..\tests\BuildWorkerFixture\src\backend\bin\**;..\..\tests\BuildWorkerFixture\src\backend\obj\**">
      <LogicalName>MnaiWork.Api.Agent.ProjectTemplate/src/backend/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\tests\BuildWorkerFixture\tests\backend.unit\**\*.cs;..\..\tests\BuildWorkerFixture\tests\backend.unit\**\*.csproj"
              Exclude="..\..\tests\BuildWorkerFixture\tests\backend.unit\bin\**;..\..\tests\BuildWorkerFixture\tests\backend.unit\obj\**">
      <LogicalName>MnaiWork.Api.Agent.ProjectTemplate/tests/backend.unit/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\tests\BuildWorkerFixture\tests\backend.integration\**\*.cs;..\..\tests\BuildWorkerFixture\tests\backend.integration\**\*.csproj"
              Exclude="..\..\tests\BuildWorkerFixture\tests\backend.integration\bin\**;..\..\tests\BuildWorkerFixture\tests\backend.integration\obj\**">
      <LogicalName>MnaiWork.Api.Agent.ProjectTemplate/tests/backend.integration/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\tests\BuildWorkerFixture\src\frontend\package.json;..\..\tests\BuildWorkerFixture\src\frontend\package-lock.json;..\..\tests\BuildWorkerFixture\src\frontend\index.html;..\..\tests\BuildWorkerFixture\src\frontend\tsconfig.json;..\..\tests\BuildWorkerFixture\src\frontend\vite.config.ts;..\..\tests\BuildWorkerFixture\src\frontend\vitest.config.ts;..\..\tests\BuildWorkerFixture\src\frontend\playwright.config.ts">
      <LogicalName>MnaiWork.Api.Agent.ProjectTemplate/src/frontend/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\tests\BuildWorkerFixture\src\frontend\src\**\*.ts;..\..\tests\BuildWorkerFixture\src\frontend\src\**\*.tsx">
      <LogicalName>MnaiWork.Api.Agent.ProjectTemplate/src/frontend/src/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\tests\BuildWorkerFixture\src\frontend\public\**\*">
      <LogicalName>MnaiWork.Api.Agent.ProjectTemplate/src/frontend/public/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\tests\BuildWorkerFixture\src\frontend\tests\**\*.ts">
      <LogicalName>MnaiWork.Api.Agent.ProjectTemplate/src/frontend/tests/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MnaiWork.BuildWorker\MnaiWork.BuildWorker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MnaiWork.Api.Tests" />
  </ItemGroup>

</Project>
