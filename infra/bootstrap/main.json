            }
          },
          "parameters": {
            "location": {
              "type": "string",
              "metadata": {
                "description": "Azure region for the shared App Service Plan."
              }
            },
            "appServicePlanName": {
              "type": "string",
              "metadata": {
                "description": "Shared Windows App Service Plan name."
